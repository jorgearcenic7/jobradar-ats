# Cabeceras de seguridad y caché de Cloudflare Pages.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY

# Archivos con hash en el nombre: su contenido no cambia nunca.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Modelo semántico: cada versión vive en su propia carpeta y no cambia. El manifiesto, que dice
# cuál es la vigente, se revalida siempre.
/semantic/:version/*
  Cache-Control: public, max-age=31536000, immutable

/semantic/manifest.json
  Cache-Control: no-cache
