  "dependencies": {
    "@expo/ui": "~58.0.26",
    "@huggingface/tokenizers": "0.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "mammoth": "1.13.0",
    "onnxruntime-web": "1.31.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node scripts/move-vendor-assets.cjs && node --disable-warning=ExperimentalWarning scripts/prepare-semantic-model.cjs dist/semantic",
    "semantic:dev": "node --disable-warning=ExperimentalWarning scripts/prepare-semantic-model.cjs node_modules/.cache/semantic-model",
    "semantic:benchmark": "npm run semantic:dev && node --disable-warning=ExperimentalWarning scripts/semantic-benchmark.mjs node_modules/.cache/semantic-model",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/jest/style-mock.js"
    }
  },
  "private": true
}
