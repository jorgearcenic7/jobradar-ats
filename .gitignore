# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Archivos de entorno: ninguno se versiona, aunque hoy solo contengan valores públicos.
.env*

# typescript
*.tsbuildinfo

# test coverage
coverage/

# Playwright MCP: sus instantáneas guardan el texto de la página, incluido el de un CV cargado.
.playwright-mcp/

# Supabase CLI: estado local del proyecto vinculado; no se versiona.
supabase/.temp/

# generated native folders
/ios
/android
