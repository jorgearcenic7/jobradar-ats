# Normalize text files to LF in the repository and the working tree
* text=auto eol=lf

# Binary files: never convert line endings or diff as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.docx binary
*.zip binary
